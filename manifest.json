{
  "manifest_version": 3,
  "name": "Market Pulse",
  "version": "1.0.0",
  "description": "Rendimenti, spread BTP/Bund, VIX e stato delle borse a colpo d'occhio. Nessun tracking.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://stooq.com/*",
    "https://api.stlouisfed.org/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Market Pulse",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
